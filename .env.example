GEMINI_API_KEY=

# --- Görsel üretimi maliyet optimizasyonu ---
# Ucuz metin modeli (sahne planlama + prompt yazma)
# GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
# Görsel modeli (referans fotoğrafı koruyarak üretir)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Pazaryeri standardı: Trendyol/HB 1200×1800 (2:3)
# GEMINI_IMAGE_ASPECT_RATIO=2:3
# GEMINI_IMAGE_OUTPUT_WIDTH=1200
# GEMINI_IMAGE_OUTPUT_HEIGHT=1800
# Referans fotoğrafı API'ye göndermeden küçült (768px) — giriş token maliyetini düşürür
# GEMINI_IMAGE_REF_MAX_PX=768
# GEMINI_IMAGE_JPEG_QUALITY=72
# GEMINI_IMAGE_DPI=96
# Batch mod: kalan sahneleri %50 indirimli üretir (1–5 dk sürebilir)
# GEMINI_IMAGE_BATCH=true
# GEMINI_IMAGE_BATCH_POLL_SEC=5
# GEMINI_IMAGE_BATCH_TIMEOUT_SEC=600

# --- E-posta doğrulama (zorunlu) ---
# Seçenek A: Resend API (https://resend.com — ücretsiz 100 mail/gün)
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=TrendolAi <onboarding@resend.dev>

# Seçenek B: Gmail SMTP (normal Gmail şifresi ÇALIŞMAZ — uygulama şifresi gerekir)
# 1) https://myaccount.google.com/security → 2 Adımlı Doğrulama açık olmalı
# 2) https://myaccount.google.com/apppasswords → "Mail" için 16 haneli şifre oluştur
# 3) SMTP_USER = tam Gmail adresin, SMTP_PASSWORD = uygulama şifresi (boşluksuz)
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=senin@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
MAIL_FROM=TrendolAi <senin@gmail.com>
SUPPORT_EMAIL=trendyolai0108@gmail.com
# Geliştirme: SMTP yokken doğrulama kodunu sunucu terminaline yazar
# MAIL_DEV_LOG=true

TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
