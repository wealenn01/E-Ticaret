# --- Zorunlu ---
# Gemini API anahtarı — ÜCRETSİZ, kredi kartı istemez.
# https://aistudio.google.com adresine Google hesabıyla girip "Get API key" ile oluştur.
# (İpucu: kişisel hesap yerine işletme için ayrı bir Google hesabı kullanabilirsin.)
GEMINI_API_KEY=...

# Opsiyonel: kullanılacak model (varsayılan: gemini-2.5-flash).
# Ücretsiz katmanda daha yeni bir Flash modeli çıktıysa buradan geçebilirsin.
#GEMINI_MODEL=gemini-2.5-flash

# --- Trendyol (henüz yoksa boş bırak -> agent DEMO modunda çalışır) ---
# Satıcı Paneli > Hesap Bilgileri > Entegrasyon Bilgileri
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
# stage | prod  (önce stage ile test etmen önerilir)
TRENDYOL_ENV=stage

# --- Opsiyonel: görsel barındırma ---
# Trendyol, ürün görsellerini herkese açık HTTPS URL olarak ister.
# imgbb.com'dan ücretsiz API anahtarı alırsan yüklenen fotoğraflar otomatik host edilir.
IMGBB_API_KEY=

# Ücretsiz katmanda gemini-2.5-flash günlük kotası düşük; flash-lite daha yüksek kotalı.
# Daha kaliteli analiz istersen bu satırı silebilirsin (varsayılan: gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash-lite
